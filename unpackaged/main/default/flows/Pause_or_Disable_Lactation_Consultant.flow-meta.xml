<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Paused_or_Disabled</name>
        <label>Paused or Disabled</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Neither</defaultConnectorLabel>
        <rules>
            <name>Pause</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paused</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Referral_Availability_to_Unavailable</targetReference>
            </connector>
            <label>Paused</label>
        </rules>
        <rules>
            <name>Disable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Disabled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Engagement_to_Terminated</targetReference>
            </connector>
            <label>Disabled</label>
        </rules>
    </decisions>
