        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>QueryRecordTypes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Grant Application</defaultConnectorLabel>
        <rules>
            <name>GrantApplication</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Record_Type_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Grant_Applicant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QueryClinicalPracticeRecordType</targetReference>
            </connector>
            <label>Grant Application</label>
        </rules>
