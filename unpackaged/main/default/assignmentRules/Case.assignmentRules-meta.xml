<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Case Assignment by Type</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Eligibility</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Eligibility</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Support_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Support Issue</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
